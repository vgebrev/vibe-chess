# Cloudflare Pages headers (§7.1). Hashed build assets never change, so they cache for a year;
# everything else (index.html, skins) keeps the default revalidation.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Hardening for every response: no MIME sniffing, only the origin in referrers to other sites,
# and no framing by other pages. Not a full CSP, which would need hashes for SvelteKit's inline
# start-up script and 'wasm-unsafe-eval' for the engine (§11 #62).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
