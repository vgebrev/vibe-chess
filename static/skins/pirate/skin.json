          "taunt": ["audio/voices/w-bishop-taunt-1.mp3", "audio/voices/w-bishop-taunt-2.mp3"]
        },
        "k": {
          "capture": ["audio/voices/w-king-capture-1.mp3", "audio/voices/w-king-capture-2.mp3", "audio/voices/w-king-capture-3.mp3"],
          "check": ["audio/voices/w-king-check-1.mp3", "audio/voices/w-king-check-2.mp3"],
          "defeat": ["audio/voices/w-king-defeat-1.mp3", "audio/voices/w-king-defeat-2.mp3"],
          "move": ["audio/voices/w-king-move-1.mp3", "audio/voices/w-king-move-2.mp3", "audio/voices/w-king-move-3.mp3"],
          "taunt": ["audio/voices/w-king-taunt-1.mp3", "audio/voices/w-king-taunt-2.mp3"]
        },
        "n": {
          "capture": ["audio/voices/w-knight-capture-1.mp3", "audio/voices/w-knight-capture-2.mp3"],
          "captured": ["audio/voices/w-knight-captured-1.mp3", "audio/voices/w-knight-captured-2.mp3"],
          "move": ["audio/voices/w-knight-move-1.mp3", "audio/voices/w-knight-move-2.mp3"]
        },
        "p": {
          "capture": ["audio/voices/w-pawn-capture-1.mp3", "audio/voices/w-pawn-capture-2.mp3", "audio/voices/w-pawn-capture-3.mp3"],
          "captured": ["audio/voices/w-pawn-captured-1.mp3", "audio/voices/w-pawn-captured-2.mp3"],
          "move": ["audio/voices/w-pawn-move-1.mp3", "audio/voices/w-pawn-move-2.mp3", "audio/voices/w-pawn-move-3.mp3"],
          "taunt": ["audio/voices/w-pawn-taunt-1.mp3", "audio/voices/w-pawn-taunt-2.mp3"]
        },
        "q": {
          "capture": ["audio/voices/w-queen-capture-1.mp3", "audio/voices/w-queen-capture-2.mp3", "audio/voices/w-queen-capture-3.mp3"],
          "captured": ["audio/voices/w-queen-captured-1.mp3", "audio/voices/w-queen-captured-2.mp3"],
          "move": ["audio/voices/w-queen-move-1.mp3", "audio/voices/w-queen-move-2.mp3", "audio/voices/w-queen-move-3.mp3"],
          "taunt": ["audio/voices/w-queen-taunt-1.mp3", "audio/voices/w-queen-taunt-2.mp3"]
        },
        "r": {
