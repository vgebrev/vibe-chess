{
  "manifestVersion": 1,
  "id": "pirate",
  "name": "Pirate",
  "board": {
    "image": "board.webp",
    "inset": { "top": 0.059, "right": 0.06, "bottom": 0.064, "left": 0.06 }
  },
  "pieces": {
    "image": "pieces.webp",
    "columns": 6,
    "rows": 2,
    "order": ["k", "q", "b", "n", "r", "p"],
    "rowFor": { "w": 1, "b": 0 },
    "scale": 0.95,
    "anchorY": 0.02,
    "anchorYFor": { "p": 0.10 }
  },
  "moveIndicator": {
    "image": "indicator-move.webp",
    "scale": 0.9,
    "opacity": 0.5
  },
  "captureIndicator": {
    "image": "indicator-capture.webp",
    "scale": 1.0,
    "opacity": 0.4
  },
  "font": {
    "family": "Pirata One",
    "files": [
      { "src": "font/PirataOne-Regular.woff2", "weight": 400, "style": "normal" }
    ],
    "fallback": "Georgia, serif",
    "license": "font/OFL.txt"
  },
  "coordinates": {
    "fontScale": 0.55
  },
  "theme": {
    "bg": "#1b120b",
    "surface": "#2b1d12",
    "surfaceRaised": "#3a2716",
    "text": "#f3e2b8",
    "textMuted": "#bfa77a",
    "accent": "#d9a441",
    "danger": "#f2766b",
    "highlightSelected": "rgba(0, 0, 0, 0.35)",
    "highlightLastMove": "rgba(255, 255, 255, 0.3)",
    "highlightCheck": "rgba(255, 45, 30, 0.8)",
    "coordText": "#f3e2b8",
    "coordShadow": "0 1px 2px rgba(0, 0, 0, 0.8)",
    "pieceShadow": "drop-shadow(0 0 0.5px rgba(0, 0, 0, 0.6)) drop-shadow(0.2cqw 0.6cqw 0.8cqw rgba(0, 0, 0, 0.45))",
    "dragShadow": "0 8px 16px rgba(0, 0, 0, 0.5)",
    "scrim": "rgba(0, 0, 0, 0.55)"
  },
  "labels": {
    "white": "Blue Crew",
    "black": "Red Crew",
    "difficulty": {
      "p0": "Cabin Boy",
      "p1": "Deckhand",
      "p2": "Bosun",
      "p3": "Quartermaster",
      "p4": "First Mate",
      "p5": "Captain"
    }
  },
  "emotes": {
    "image": "emotes.webp",
    "columns": 4,
    "rows": 2,
    "scale": 1.3,
    "events": {
      "taunt": [0, 1, 2, 6]
    }
  },
  "results": {
    "win": { "w": "result-win-blue.webp", "b": "result-win-red.webp" },
    "loss": { "w": "result-loss-blue.webp", "b": "result-loss-red.webp" },
    "resign": "result-resign.webp",
    "draw": "result-draw.webp"
  },
  "audio": {
    "music": ["audio/music/battle-alt.mp3", "audio/music/battle.mp3", "audio/music/midnight.mp3", "audio/music/sailing.mp3", "audio/music/shanty.mp3", "audio/music/tavern-alt.mp3", "audio/music/tavern.mp3"],
    "sfx": {
      "capture": "audio/sfx/capture.mp3",
      "castle": "audio/sfx/castle.mp3",
      "check": "audio/sfx/check.mp3",
      "click": "audio/sfx/click.mp3",
      "checkmate": "audio/sfx/checkmate.mp3",
      "start": "audio/sfx/start.mp3",
      "illegal": "audio/sfx/illegal.mp3",
      "move": "audio/sfx/move.mp3",
      "promotion": "audio/sfx/promotion.mp3",
      "select": "audio/sfx/select.mp3",
      "draw": "audio/sfx/draw.mp3"
    },
    "voices": {
      "b": {
        "b": {
          "capture": ["audio/voices/b-bishop-capture-1.mp3", "audio/voices/b-bishop-capture-2.mp3", "audio/voices/b-bishop-capture-3.mp3"],
          "captured": ["audio/voices/b-bishop-captured-1.mp3", "audio/voices/b-bishop-captured-2.mp3"],
          "move": ["audio/voices/b-bishop-move-1.mp3", "audio/voices/b-bishop-move-2.mp3", "audio/voices/b-bishop-move-3.mp3"],
          "taunt": ["audio/voices/b-bishop-taunt-1.mp3", "audio/voices/b-bishop-taunt-2.mp3"]
        },
        "k": {
          "capture": ["audio/voices/b-king-capture-1.mp3", "audio/voices/b-king-capture-2.mp3", "audio/voices/b-king-capture-3.mp3"],
          "check": ["audio/voices/b-king-check-1.mp3", "audio/voices/b-king-check-2.mp3"],
          "defeat": ["audio/voices/b-king-defeat-1.mp3", "audio/voices/b-king-defeat-2.mp3"],
          "move": ["audio/voices/b-king-move-1.mp3", "audio/voices/b-king-move-2.mp3", "audio/voices/b-king-move-3.mp3"],
          "taunt": ["audio/voices/b-king-taunt-1.mp3", "audio/voices/b-king-taunt-2.mp3"]
        },
        "n": {
          "capture": ["audio/voices/b-knight-capture-1.mp3", "audio/voices/b-knight-capture-2.mp3"],
          "captured": ["audio/voices/b-knight-captured-1.mp3", "audio/voices/b-knight-captured-2.mp3"],
          "move": ["audio/voices/b-knight-move-1.mp3", "audio/voices/b-knight-move-2.mp3"]
        },
        "p": {
          "capture": ["audio/voices/b-pawn-capture-1.mp3", "audio/voices/b-pawn-capture-2.mp3", "audio/voices/b-pawn-capture-3.mp3"],
          "captured": ["audio/voices/b-pawn-captured-1.mp3", "audio/voices/b-pawn-captured-2.mp3"],
          "move": ["audio/voices/b-pawn-move-1.mp3", "audio/voices/b-pawn-move-2.mp3", "audio/voices/b-pawn-move-3.mp3"],
          "taunt": ["audio/voices/b-pawn-taunt-1.mp3", "audio/voices/b-pawn-taunt-2.mp3"]
        },
        "q": {
          "capture": ["audio/voices/b-queen-capture-1.mp3", "audio/voices/b-queen-capture-2.mp3", "audio/voices/b-queen-capture-3.mp3"],
          "captured": ["audio/voices/b-queen-captured-1.mp3", "audio/voices/b-queen-captured-2.mp3"],
          "move": ["audio/voices/b-queen-move-1.mp3", "audio/voices/b-queen-move-2.mp3", "audio/voices/b-queen-move-3.mp3"],
          "taunt": ["audio/voices/b-queen-taunt-1.mp3", "audio/voices/b-queen-taunt-2.mp3"]
        },
        "r": {
